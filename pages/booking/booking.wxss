.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 48rpx 32rpx 64rpx;
}





.place-card {
    padding: 24rpx 26rpx;
    margin-bottom: 20rpx;    border-radius: 24rpx;
    background: var(--color-surface);
}

.place-name {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    color: var(--color-text);
}

.place-address {
    display: block;
    margin-top: 10rpx;
    color: var(--color-text-2);
    font-size: 26rpx;
    line-height: 1.5;
}

.place-tel {
    display: block;
    margin-top: 8rpx;
    color: var(--color-primary);
    font-size: 26rpx;
}


.form-card {
    padding: 28rpx 26rpx;    border-radius: 24rpx;
    background: var(--color-surface);
}

.form-error {
    display: block;
    padding: 14rpx 18rpx;
    margin-bottom: 16rpx;
    border-radius: 16rpx;
    background: var(--color-danger-weak);
    color: var(--color-primary-deep);
    font-size: 24rpx;
}

.field-group {
    margin-bottom: 22rpx;
}

.field-label {
    display: block;
    margin-bottom: 10rpx;
    color: var(--color-text-2);
    font-size: 26rpx;
}

.required {
    color: var(--color-danger);
}

.picker {
    box-sizing: border-box;
    width: 100%;
    padding: 20rpx 24rpx;    border-radius: 16rpx;
    background: var(--color-muted-weak);
    color: var(--color-text);
    font-size: 28rpx;
}

.picker-static {
    background: var(--color-bg);
    color: var(--color-text-2);
}

.field-textarea {
    box-sizing: border-box;
    width: 100%;
    min-height: 130rpx;
    padding: 20rpx 24rpx;    border-radius: 16rpx;
    background: var(--color-muted-weak);
    font-size: 28rpx;
}

.form-tip {
    display: block;
    margin-top: 18rpx;
    color: var(--color-text-3);
    font-size: 24rpx;
    line-height: 1.6;
}
