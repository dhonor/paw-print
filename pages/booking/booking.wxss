.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 48rpx 32rpx 64rpx;
}





.place-card {
    padding: 24rpx 26rpx;
    margin-bottom: 20rpx;    border-radius: 24rpx;
    background: #ffffff;
}

.place-name {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    color: #3a2a22;
}

.place-address {
    display: block;
    margin-top: 10rpx;
    color: #7a675c;
    font-size: 26rpx;
    line-height: 1.5;
}

.place-tel {
    display: block;
    margin-top: 8rpx;
    color: #ff8a65;
    font-size: 26rpx;
}


.form-card {
    padding: 28rpx 26rpx;    border-radius: 24rpx;
    background: #ffffff;
}

.form-error {
    display: block;
    padding: 14rpx 18rpx;
    margin-bottom: 16rpx;
    border-radius: 16rpx;
    background: #ffeee8;
    color: #c24a2c;
    font-size: 24rpx;
}

.field-group {
    margin-bottom: 22rpx;
}

.field-label {
    display: block;
    margin-bottom: 10rpx;
    color: #7a675c;
    font-size: 26rpx;
}

.required {
    color: #e2574c;
}

.picker {
    box-sizing: border-box;
    width: 100%;
    padding: 20rpx 24rpx;    border-radius: 16rpx;
    background: #fbf1e9;
    color: #3a2a22;
    font-size: 28rpx;
}

.picker-static {
    background: #fff7f0;
    color: #7a675c;
}

.field-textarea {
    box-sizing: border-box;
    width: 100%;
    min-height: 130rpx;
    padding: 20rpx 24rpx;    border-radius: 16rpx;
    background: #fbf1e9;
    font-size: 28rpx;
}

.form-tip {
    display: block;
    margin-top: 18rpx;
    color: #806b5e;
    font-size: 24rpx;
    line-height: 1.6;
}
