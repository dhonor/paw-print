<view class="page">
    <view class="brand">
        <image class="brand-logo" src="/assets/icons/paw.png" />
        <text class="brand-name">{{appName}}</text>
        <text class="brand-slogan">{{slogan}}</text>
        <text class="version-text">{{version}}<text wx:if="{{envText}}"> · {{envText}}</text></text>
    </view>

    <text class="intro">{{intro}}</text>

    <view class="link-card" hover-class="link-card-hover" bindtap="goFeedback">
        <image class="link-icon" src="/assets/icons/feedback.png" />
        <text class="link-text">意见反馈</text>
        <image class="link-arrow" src="/assets/icons/chevron-right.png" />
    </view>

    <view class="link-card" hover-class="link-card-hover" bindtap="goPrivacy">
        <image class="link-icon" src="/assets/icons/info.png" />
        <text class="link-text">隐私政策</text>
        <image class="link-arrow" src="/assets/icons/chevron-right.png" />
    </view>

    <view class="footer">
        <text class="footer-brand">爪印 · PAW-PRINT</text>
        <text class="footer-sub">记录是为了更早发现问题，不构成医疗诊断</text>
    </view>
</view>
