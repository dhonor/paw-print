.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx;
}

.form-card {
    box-sizing: border-box;
    padding: 8rpx 32rpx 24rpx;
    border-radius: 24rpx;
    background: var(--color-surface);
}

.field-group {
    margin-top: 24rpx;
}

.field-label {
    display: block;
    margin-bottom: 12rpx;
    font-size: 26rpx;
    color: var(--color-text);
}

.required {
    color: var(--color-primary-deep);
}

.field-input,
.picker {
    box-sizing: border-box;
    width: 100%;
    min-height: 88rpx;
    border-radius: 16rpx;
    padding: 18rpx 20rpx;
    background: var(--color-muted-weak);
    color: var(--color-text);
    font-size: 28rpx;
}

.picker {
    display: flex;
    align-items: center;
    min-height: 88rpx;
    color: var(--color-text);
}

.avatar-row {
    display: flex;
    flex-wrap: wrap;
}

.avatar-option {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80rpx;
    height: 80rpx;
    text-align: center;
    font-size: 40rpx;
    margin: 0 16rpx 16rpx 0;
    border-radius: 16rpx;
    background: var(--color-bg);
}

.avatar-option-active {
    border-color: var(--color-primary);
    background: var(--color-primary-weak);
}

.field-textarea {
    box-sizing: border-box;
    width: 100%;
    min-height: 160rpx;
    border-radius: 16rpx;
    padding: 18rpx 20rpx;
    background: var(--color-muted-weak);
    color: var(--color-text);
    font-size: 28rpx;
}

.form-error {
    display: block;
    margin-top: 24rpx;
    padding: 14rpx 18rpx;
    border-radius: 16rpx;
    background: var(--color-danger-weak);
    color: var(--color-primary-deep);
    font-size: 24rpx;
}

.save-button {
    margin-top: 32rpx;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 30rpx;
}

/* 头像上传入口 */
.avatar-option-upload {
    background: #fffaf5;
}

.avatar-upload-plus {
    color: var(--color-primary-deep);
    font-size: 40rpx;
    line-height: 1;
}

.field-hint {
    display: block;
    margin-top: 4rpx;
    color: var(--color-text-3);
    font-size: 22rpx;
}
