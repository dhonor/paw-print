<view class="page">
    <view class="form-card">
        <view class="field-group">
            <text class="field-label">昵称 <text class="required">*</text></text>
            <input class="field-input" placeholder="给宠物起个名字" value="{{name}}" bindinput="onName" maxlength="20" />
        </view>

        <view class="field-group">
            <text class="field-label">头像</text>
            <view class="avatar-row">
                <view class="avatar-option {{index === avatarIndex ? 'avatar-option-active' : ''}}"
                    wx:for="{{avatarOptions}}" wx:key="*this" data-index="{{index}}" bindtap="onAvatar">
                    <image class="avatar-img" src="/assets/icons/avatar-{{item}}.png" />
                </view>
                <view class="avatar-option avatar-option-upload {{avatarIndex === -1 ? 'avatar-option-active' : ''}}"
                    bindtap="onUploadAvatar">
                    <image wx:if="{{avatarCustom}}" class="avatar-img" src="{{avatarCustom}}" mode="aspectFill" binderror="onAvatarError" />
                    <text wx:else class="avatar-upload-plus">+</text>
                </view>
            </view>
            <text class="field-hint">点「+」可以从相册选照片或拍照</text>
        </view>

        <view class="field-group">
            <text class="field-label">物种</text>
            <picker mode="selector" range="{{speciesOptions}}" value="{{speciesIndex}}" bindchange="onSpecies">
                <view class="picker">{{speciesOptions[speciesIndex]}}</view>
            </picker>
        </view>

        <view class="field-group">
            <text class="field-label">性别</text>
            <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGender">
                <view class="picker">{{genderOptions[genderIndex]}}</view>
            </picker>
        </view>

        <view class="field-group">
            <text class="field-label">品种</text>
            <input class="field-input" placeholder="如：柯基 / 英短" value="{{breed}}" bindinput="onBreed" maxlength="20" />
        </view>

        <view class="field-group">
            <text class="field-label">生日</text>
            <picker mode="date" value="{{birthday}}" bindchange="onBirthday">
                <view class="picker">{{birthday === '' ? '请选择生日' : birthday}}</view>
            </picker>
        </view>

        <view class="field-group">
            <text class="field-label">芯片号</text>
            <input class="field-input" placeholder="如：900215000123456" value="{{microchip}}" bindinput="onMicrochip" maxlength="30" />
        </view>

        <view class="field-group">
            <text class="field-label">紧急联系电话</text>
            <input class="field-input" type="number" placeholder="走失时可联系的人" value="{{emergencyContact}}" bindinput="onEmergencyContact" maxlength="20" />
        </view>

        <view class="field-group">
            <text class="field-label">绝育情况</text>
            <picker mode="selector" range="{{sterilizedOptions}}" value="{{sterilizedIndex}}" bindchange="onSterilized">
                <view class="picker">{{sterilizedOptions[sterilizedIndex]}}</view>
            </picker>
        </view>

        <view class="field-group">
            <text class="field-label">备注</text>
            <textarea class="field-textarea" placeholder="性格、喜好等补充说明" value="{{note}}" bindinput="onNote" maxlength="200" />
        </view>

        <text class="form-error" wx:if="{{error !== ''}}">{{error}}</text>
    </view>

    <button class="save-button" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存</button>
</view>
