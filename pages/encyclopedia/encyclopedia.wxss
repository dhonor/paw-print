.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 48rpx 32rpx 64rpx;
    background: var(--color-bg);
}

.search-bar {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding: 18rpx 24rpx;
    border-radius: 16rpx;
    background: var(--color-muted-weak);
}

.search-icon {
    font-size: 30rpx;
    margin-right: 14rpx;
}

.search-input {
    flex: 1;
    font-size: 28rpx;
    color: var(--color-text);
}

.chips {
    white-space: nowrap;
    margin-top: 24rpx;
}

.chip {
    display: inline-block;
    padding: 12rpx 30rpx;
    margin-right: 16rpx;
    border-radius: 999rpx;
    background: var(--color-surface);
    color: var(--color-text-2);
    font-size: 26rpx;
}

.chip-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
}

.pet-list {
    margin-top: 24rpx;
}

.pet-card {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding: 28rpx 28rpx;
    margin-bottom: 18rpx;
    border-radius: 24rpx;
    background: var(--color-surface);
}

.pet-icon {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    background: var(--color-primary-weak);
    color: var(--color-primary);
    font-size: 44rpx;
    line-height: 88rpx;
    text-align: center;
    flex-shrink: 0;
}

.pet-info {
    flex: 1;
    margin-left: 22rpx;
    overflow: hidden;
}

.pet-name-row {
    display: flex;
    align-items: center;
}

.pet-name {
    font-size: 32rpx;
    font-weight: 600;
    color: var(--color-text);
}

.pet-cat {
    margin-left: 14rpx;
    padding: 4rpx 14rpx;
    border-radius: 999rpx;
    background: var(--color-muted-weak);
    color: var(--color-text-2);
    font-size: 22rpx;
}

.pet-line {
    display: block;
    margin-top: 10rpx;
    color: var(--color-text-2);
    font-size: 26rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.pet-arrow {
    color: var(--color-text-3);
    font-size: 36rpx;
    margin-left: 8rpx;
}

.detail-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: rgba(58, 42, 34, 0.36);
}

.detail-sheet {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    box-sizing: border-box;
    max-height: 86vh;
    overflow-y: auto;
    padding: 36rpx 32rpx 48rpx;
    border-radius: 28rpx 28rpx 0 0;
    background: var(--color-surface);
}

.detail-header {
    display: flex;
    align-items: center;
}

.detail-icon {
    width: 96rpx;
    height: 96rpx;
    flex-shrink: 0;
    flex-shrink: 0;
}

.detail-title-wrap {
    flex: 1;
    margin-left: 22rpx;
}

.detail-name {
    display: block;
    font-size: 36rpx;
    font-weight: 700;
    color: var(--color-text);
}

.detail-cat {
    display: block;
    margin-top: 8rpx;
    font-size: 24rpx;
    color: var(--color-text-2);
}

.detail-close {
    color: var(--color-text-3);
    font-size: 36rpx;
    padding: 8rpx 12rpx;
}

.detail-body {
    margin-top: 28rpx;
}

.detail-row {
    display: flex;
    align-items: flex-start;
    padding: 20rpx 0;
}

.detail-label {
    width: 150rpx;
    flex-shrink: 0;
    color: var(--color-text-3);
    font-size: 26rpx;
}

.detail-value {
    flex: 1;
    color: var(--color-text);
    font-size: 28rpx;
    line-height: 1.6;
}

.detail-block {
    display: flex;
    flex-direction: column;
    padding: 20rpx 0;
}

.detail-intro {
    margin-top: 12rpx;
    color: var(--color-text);
    font-size: 28rpx;
    line-height: 1.7;
}
