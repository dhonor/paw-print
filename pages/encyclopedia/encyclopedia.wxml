<view class="page">
    <view class="hero">
        <text class="eyebrow">ENCYCLOPEDIA</text>
        <text class="title">品种百科</text>
        <text class="subtitle">常见宠物性格、寿命与喂养速查</text>
    </view>

    <view class="search-bar">
        <image class="search-icon" src="/assets/icons/search.png" />
        <input class="search-input" placeholder="搜索名称或性格，如：温顺、金毛" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
    </view>

    <scroll-view class="chips" scroll-x="true">
        <view class="chip {{activeCategory === item.key ? 'chip-active' : ''}}"
            wx:for="{{categories}}" wx:key="key" data-key="{{item.key}}" bindtap="onCategory">
            {{item.text}}
        </view>
    </scroll-view>

    <view class="state-card" wx:if="{{list.length === 0}}">
        <image class="state-icon" src="/assets/icons/paw.png" />
        <text class="state-title">没有匹配的宠物</text>
        <text class="state-description">换个关键词或分类试试</text>
    </view>

    <view class="pet-list" wx:else>
        <view class="pet-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
            <image class="pet-icon" src="/assets/icons/{{item.icon}}.png" />
            <view class="pet-info">
                <view class="pet-name-row">
                    <text class="pet-name">{{item.name}}</text>
                    <text class="pet-cat">{{item.categoryText}}</text>
                </view>
                <text class="pet-line">性格 · {{item.personality}}</text>
                <text class="pet-line">寿命 · {{item.lifespan}}　体型 · {{item.size}}</text>
            </view>
            <text class="pet-arrow">›</text>
        </view>
    </view>

    <view class="detail-mask" wx:if="{{showDetail}}" bindtap="closeDetail"></view>
    <view class="detail-sheet" wx:if="{{showDetail}}">
        <view class="detail-header">
            <image class="detail-icon" src="/assets/icons/{{detail.avatarIcon}}.png" />
            <view class="detail-title-wrap">
                <text class="detail-name">{{detail.name}}</text>
                <text class="detail-cat">{{detail.categoryText}}</text>
            </view>
            <image class="detail-close" bindtap="closeDetail" src="/assets/icons/close.png" />
        </view>
        <view class="detail-body">
            <view class="detail-row">
                <text class="detail-label">性格</text>
                <text class="detail-value">{{detail.personality}}</text>
            </view>
            <view class="detail-row">
                <text class="detail-label">寿命</text>
                <text class="detail-value">{{detail.lifespan}}</text>
            </view>
            <view class="detail-row">
                <text class="detail-label">体型</text>
                <text class="detail-value">{{detail.size}}</text>
            </view>
            <view class="detail-row">
                <text class="detail-label">喂养难度</text>
                <text class="detail-value">{{detail.difficulty}}</text>
            </view>
            <view class="detail-row">
                <text class="detail-label">饮食建议</text>
                <text class="detail-value">{{detail.diet}}</text>
            </view>
            <view class="detail-block">
                <text class="detail-label">简介</text>
                <text class="detail-intro">{{detail.intro}}</text>
            </view>
        </view>
    </view>
</view>
