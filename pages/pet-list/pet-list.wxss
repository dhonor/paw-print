.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 48rpx 32rpx 64rpx;
}


.list-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.list-count {
    color: var(--color-text-2);
    font-size: 25rpx;
}

.list-add {
    padding: 0 26rpx;
    min-height: 68rpx;
    line-height: 68rpx;
    border-radius: 999rpx;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 26rpx;
}

.list-add-hover {
    background: #f4734b;
}

.pet-item {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding: 28rpx 26rpx;
    margin-bottom: 16rpx;
    border-radius: 24rpx;
    background: var(--color-surface);
    box-shadow: 0 6rpx 20rpx rgba(58, 42, 34, 0.05);
}

.pet-main {
    flex: 1;
    padding-right: 20rpx;
}

.pet-name {
    display: block;
    font-size: 30rpx;
    font-weight: 600;
    color: var(--color-text);
}

.pet-meta {
    display: block;
    margin-top: 10rpx;
    color: var(--color-text-2);
    font-size: 26rpx;
}

.pet-breed {
    display: block;
    margin-top: 6rpx;
    color: var(--color-text-3);
    font-size: 22rpx;
}


.pet-delete {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 72rpx;
    padding: 0 8rpx 0 20rpx;
    color: var(--color-danger);
    font-size: 25rpx;
}



/* 列表项头像 */
.pet-item-avatar {
    flex-shrink: 0;
    width: 88rpx;
    height: 88rpx;
    margin-right: 20rpx;
    border-radius: 24rpx;
    background: var(--color-primary-weak);
}
