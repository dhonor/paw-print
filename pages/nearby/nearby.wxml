<view class="page">
    <view class="hero">
        <text class="eyebrow">NEARBY</text>
        <text class="title">周边服务</text>
        <text class="subtitle">按你的位置，找附近的宠物医院、美容院、商店与乐园</text>
    </view>

    <view class="location-bar" bindtap="onRelocate">
        <image class="location-icon" src="/assets/icons/pin.png" />
        <text class="location-text">{{locationText}}</text>
        <text class="location-action">重新定位</text>
    </view>

    <scroll-view class="chips" scroll-x="true" wx:if="{{state !== 'denied'}}">
        <view class="chip {{activeKey === item.key ? 'chip-active' : ''}}"
            wx:for="{{categories}}" wx:key="key"
            data-key="{{item.key}}" bindtap="onCategoryTap">
            <image class="chip-icon" src="/assets/icons/{{item.icon}}.png" />
            <text class="chip-text">{{item.label}}</text>
        </view>
    </scroll-view>

    <view class="state-card" wx:if="{{state === 'locating'}}">
        <view class="spinner"></view>
        <text class="state-title">正在获取你的位置</text>
        <text class="state-description">授权后即可查看附近的宠物服务</text>
    </view>

    <view class="state-card" wx:elif="{{state === 'searching'}}">
        <view class="spinner"></view>
        <text class="state-title">正在搜索附近的{{activeLabel}}</text>
        <text class="state-description">按距离从近到远排序</text>
    </view>

    <view class="state-card state-card-error" wx:elif="{{state === 'denied'}}">
        <image class="state-icon" src="/assets/icons/pin.png" />
        <text class="state-title">需要位置权限</text>
        <text class="state-description">「周边服务」会读取你的位置，用来搜索附近的宠物医院、美容院、商店和乐园。位置只用于本次搜索，不会保存。</text>
        <button class="primary-button" bindtap="onOpenSetting">去开启权限</button>
    </view>

    <view class="state-card state-card-error" wx:elif="{{state === 'error'}}">
        <text class="state-icon">!</text>
        <text class="state-title">获取失败</text>
        <text class="state-description">{{errorMsg}}</text>
        <button class="primary-button" bindtap="onRetry">重试</button>
    </view>

    <view class="state-card" wx:elif="{{state === 'empty'}}">
        <view class="empty-icon"><image class="empty-icon-img" src="/assets/icons/paw.png" /></view>
        <text class="state-title">附近暂时没有找到{{activeLabel}}</text>
        <text class="state-description">可以换个分类，或者稍后重新定位试试</text>
        <button class="primary-button" bindtap="onRelocate">重新定位</button>
    </view>

    <block wx:else>
        <view class="result-head">
            <text class="result-title">附近的{{activeLabel}}</text>
            <text class="result-count">{{placeCount}} 家</text>
        </view>

        <view class="place" wx:for="{{places}}" wx:key="id" data-index="{{index}}" bindtap="onPlaceTap">
            <view class="place-head">
                <text class="place-title">{{item.title}}</text>
                <text class="place-distance" wx:if="{{item.distanceText}}">{{item.distanceText}}</text>
            </view>
            <text class="place-address" wx:if="{{item.address}}">{{item.address}}</text>
            <view class="place-foot">
                <view class="place-tel" wx:if="{{item.tel}}"><image class="icon icon-sm" src="/assets/icons/phone.png" /><text>{{item.tel}}</text></view>
                <text class="place-tel" wx:else>查看详情</text>
                <view class="place-actions">
                    <text class="place-book" data-index="{{index}}" catchtap="onBook">预约</text>
                    <text class="place-nav">导航 ›</text>
                </view>
            </view>
        </view>
    </block>
</view>
