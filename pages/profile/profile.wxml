<view class="page">
    <view class="hero">
        <text class="eyebrow">PROFILE</text>
        <text class="title">{{title}}</text>
        <text class="subtitle">{{subtitle}}</text>
    </view>

    <view class="profile-card">
        <view class="avatar" bindtap="onChangeAvatar" hover-class="avatar-hover">
            <image class="avatar-img" src="{{avatarImg}}" mode="aspectFill" binderror="onAvatarError" />
            <view class="avatar-badge">换</view>
        </view>
        <view class="profile-main">
            <view class="nickname-row" bindtap="onEditNickname" hover-class="nickname-row-hover">
                <text class="nickname">{{displayNickname}}</text>
                <text class="nickname-edit">修改</text>
            </view>
            <text class="intro">{{displayIntro}}</text>
        </view>
    </view>

    <view class="menu-card" wx:for="{{menuGroups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="key">
        <view class="menu-item"
            wx:for="{{group.items}}" wx:for-item="menuItem" wx:for-index="itemIndex" wx:key="key"
            data-group="{{groupIndex}}" data-index="{{itemIndex}}" bindtap="handleMenuTap">
            <view class="menu-icon"><image class="menu-icon-img" src="/assets/icons/{{menuItem.icon}}.png" /></view>
            <text class="menu-text">{{menuItem.text}}</text>
            <text class="menu-arrow">›</text>
        </view>
    </view>
</view>
