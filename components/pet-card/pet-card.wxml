<view class="pet-card" bindtap="onTap">
    <view class="avatar"><image class="avatar-img {{avatarFill ? 'avatar-img-fill' : ''}}" src="{{avatarSrc}}" mode="aspectFill" binderror="onAvatarError" /></view>
    <view class="info">
        <text class="name">{{pet.name}}</text>
        <text class="meta">{{pet.species}} · {{pet.gender}} · {{age}}</text>
        <text class="breed" wx:if="{{pet.breed}}">{{pet.breed}}</text>
    </view>
    <text class="arrow">›</text>
</view>
